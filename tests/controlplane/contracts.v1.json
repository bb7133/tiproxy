      "fault_scenarios": ["CP-FAULT-ETCD-TRANSIENT", "CP-FAULT-LEASE-LOSS"],
      "bridge_messages": [],
      "handoff": "The Rust election/session object must prove one active owner and the same retirement boundary before owner-only jobs move."
    },
