        {"path": "pkg/manager/vip/manager_test.go", "contains": "func TestPreClosePreventsReacquireDuringElectionClose"}
      ],
      "observed_fields": ["owner_id", "fencing_generation", "vip_address", "interface", "bind_state", "garp_count"],
      "fault_scenarios": ["CP-FAULT-VIP-OWNER-LOSS", "CP-FAULT-PROCESS-DEATH"],
      "bridge_messages": [],
      "handoff": "Move VIP and owner-only jobs together, retaining remove-before-lease-release ordering and explicit fencing evidence."
    },
    {
      "id": "CP-METER-001",
      "family": "metering",
      "summary": "Absolute producer-qualified counters are durable, ACKed, deduplicated, gap-checked, generation-isolated, and exactly once across restart.",
      "go_owner": "pkg/controlbridge and pkg/manager/meter",
      "rust_target": "#148",
      "go_baseline": "anchored",
      "rust_status": "pending",
      "anchors": [
        {"path": "pkg/controlbridge/metering_absolute_test.go", "contains": "func TestAbsoluteMeteringDeltasRedirectFinalAndRestart"},
        {"path": "pkg/controlbridge/metering_absolute_test.go", "contains": "func TestAbsoluteMeteringRejectsUnknownGapMutationAndHandlesWrap"},
        {"path": "pkg/manager/meter/meter_test.go", "contains": "func TestMeterPendingWindowRetriesIdenticallyAfterRestart"}
      ],
      "observed_fields": ["producer_id", "generation", "sequence", "last_applied_sequence", "absolute_bytes", "durable_batches"],
      "fault_scenarios": ["CP-FAULT-METER-DUPLICATE", "CP-FAULT-METER-GAP", "CP-FAULT-METER-RESTART"],
      "bridge_messages": ["metering_batch", "metering_ack"],
      "handoff": "Rust persistence must replay the same absolute window and receive a durable ACK before the Go sink is removed."
    },
