  "contracts": [
    {
      "id": "CP-API-001",
      "family": "api",
      "summary": "Admin config, status, drain, close, health, and diagnostic responses retain Go status codes, bounded errors, and idempotency.",
      "go_owner": "pkg/server/api",
      "rust_target": "#150",
      "go_baseline": "anchored",
      "rust_status": "pending",
      "anchors": [
        {"path": "pkg/server/api/config_test.go", "contains": "func TestConfig"},
        {"path": "pkg/server/api/dataplane_test.go", "contains": "func TestDataplaneStatusAPI"},
        {"path": "pkg/controlbridge/drain_metering_test.go", "contains": "func TestDrainCommandRoundTripContract"}
      ],
      "observed_fields": ["http_status", "response_code", "drain_id", "command_sequence", "applied_generation"],
      "fault_scenarios": ["CP-FAULT-ADMIN-DRAIN-REPLAY", "CP-FAULT-CONTROL-UNAVAILABLE"],
      "bridge_messages": ["drain_command", "drain_result", "close_command", "close_result"],
      "handoff": "Implement CP-ADMIN against these responses before retiring the Go API and operator bridge."
    },
    {
      "id": "CP-BRIDGE-001",
      "family": "bridge",
      "summary": "In-process control startup preserves version negotiation, capabilities, epoch and generation lineage, request correlation, bounded queues, and fail-closed reconnect behavior.",
      "go_owner": "pkg/controlbridge and pkg/controlbridge/transport",
      "rust_target": "#142",
      "go_baseline": "anchored",
      "rust_status": "pending",
      "anchors": [
        {"path": "pkg/controlbridge/transport/server_test.go", "contains": "func TestServerHandshakeLifecycleAndReconnect"},
        {"path": "pkg/controlbridge/bridge_test.go", "contains": "func TestBridgeOwnsListenerAndCadenceLifecycle"},
        {"path": "pkg/controlbridge/pb/codec_test.go", "contains": "func TestFrameBoundsAndPartialIO"}
      ],
      "observed_fields": ["protocol_version", "capabilities", "control_epoch", "generation", "request_id", "process_id"],
      "fault_scenarios": ["CP-FAULT-BRIDGE-RECONNECT", "CP-FAULT-PROCESS-DEATH"],
      "bridge_messages": ["hello", "hello_ack", "heartbeat", "error", "reconcile_request", "reconcile_snapshot"],
      "handoff": "Replace transport with direct calls only after the same state-machine observations pass in one Rust process."
    },
    {
      "id": "CP-CONFIG-001",
      "family": "config",
      "summary": "Config parsing, defaults, validation, cloning, reload, removal, and checksums remain atomic and deterministic.",
      "go_owner": "lib/config and pkg/manager/config",
      "rust_target": "#146",
      "go_baseline": "anchored",
      "rust_status": "pending",
      "anchors": [
        {"path": "lib/config/proxy_test.go", "contains": "func TestProxyConfig"},
        {"path": "pkg/manager/config/config_test.go", "contains": "func TestConfigReload"},
        {"path": "pkg/manager/config/config_test.go", "contains": "func TestChecksum"}
      ],
      "observed_fields": ["checksum", "reload_result", "validation_class", "effective_defaults", "restart_required"],
      "fault_scenarios": ["CP-FAULT-CONFIG-INVALID-RELOAD"],
      "bridge_messages": ["state_snapshot", "snapshot_result"],
      "handoff": "Land the Rust config model with a field-level parity table and atomic last-good reload behavior."
    },
    {
      "id": "CP-CONFIG-002",
      "family": "config",
      "summary": "Every dynamic control value is projected in stable order while unsupported or restart-required changes fail closed.",
      "go_owner": "pkg/controlbridge/snapshot.go",
      "rust_target": "#146",
      "go_baseline": "anchored",
      "rust_status": "pending",
      "anchors": [
        {"path": "pkg/controlbridge/snapshot_test.go", "contains": "func TestSnapshotBuilderBuildsCompleteDeterministicSnapshot"},
        {"path": "pkg/controlbridge/snapshot_test.go", "contains": "func TestSnapshotBuilderRejectsUnsafeOrRestartRequiredValues"},
        {"path": "pkg/controlbridge/snapshot_publisher_test.go", "contains": "func TestSnapshotPublisherApplyRejectReconnectAndCoalesce"}
      ],
      "observed_fields": ["generation", "listener_address", "backend_address", "namespace", "apply_code"],
      "fault_scenarios": ["CP-FAULT-CONFIG-SNAPSHOT-REJECT"],
      "bridge_messages": ["state_snapshot", "snapshot_result"],
      "handoff": "Use the catalog as the temporary migration boundary; delete snapshot encoding only after its Rust state object is differential-green."
    },
    {
      "id": "CP-CONFIG-003",
      "family": "config",
      "summary": "Certificate and TLS policy changes rotate safely for new connections without corrupting established sessions or accepting partial material.",
      "go_owner": "pkg/manager/cert",
      "rust_target": "#146",
      "go_baseline": "anchored",
      "rust_status": "pending",
      "anchors": [
        {"path": "pkg/manager/cert/manager_test.go", "contains": "func TestRotate"},
        {"path": "pkg/manager/cert/manager_test.go", "contains": "func TestWatchConfig"},
        {"path": "pkg/controlbridge/snapshot.go", "contains": "minimum TLS version must be 1.2 or 1.3"}
      ],
      "observed_fields": ["certificate_generation", "minimum_tls_version", "allowed_common_names", "existing_session_state", "new_connection_result"],
      "fault_scenarios": ["CP-FAULT-TLS-ROTATION"],
      "bridge_messages": ["state_snapshot", "snapshot_result"],
      "handoff": "Rust owns certificate watchers and atomic TLS config swaps before Go cert management can be removed."
    },
    {
