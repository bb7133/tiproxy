{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pingcap/tiproxy/tests/controlplane/schema/contracts.v1.schema.json",
  "title": "TiProxy control-plane contract catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "families", "contracts", "bridge_messages"],
  "properties": {
    "schema_version": {"const": 1},
    "families": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "family", "summary", "go_owner", "rust_target", "go_baseline",
          "rust_status", "anchors", "observed_fields", "fault_scenarios",
          "bridge_messages", "handoff"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^CP-[A-Z]+-[0-9]{3}$"},
          "family": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "go_owner": {"type": "string", "minLength": 1},
          "rust_target": {"type": "string", "pattern": "^#[0-9]+$"},
          "go_baseline": {"const": "anchored"},
          "rust_status": {"enum": ["pending", "shadow", "parity", "owned"]},
          "anchors": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "contains"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "contains": {"type": "string", "minLength": 1}
              }
            }
          },
          "observed_fields": {"$ref": "#/$defs/nonemptyStrings"},
          "fault_scenarios": {"$ref": "#/$defs/nonemptyStrings"},
          "bridge_messages": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "handoff": {"type": "string", "minLength": 1}
        }
      }
    },
    "bridge_messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "direction", "target_issue"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "direction": {"enum": ["go_to_rust", "rust_to_go", "bidirectional"]},
          "target_issue": {"type": "string", "pattern": "^#[0-9]+$"}
        }
      }
    }
  },
  "$defs": {
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
