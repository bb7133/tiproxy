{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pingcap/tiproxy/tests/controlplane/schema/fault-scenarios.v1.schema.json",
  "title": "TiProxy control-plane fault catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenarios"],
  "properties": {
    "schema_version": {"const": 1},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "summary", "target_issue", "contracts", "steps", "expectations", "observed_fields"],
        "properties": {
          "id": {"type": "string", "pattern": "^CP-FAULT-[A-Z0-9-]+$"},
          "summary": {"type": "string", "minLength": 1},
          "target_issue": {"type": "string", "pattern": "^#[0-9]+$"},
          "contracts": {"$ref": "#/$defs/nonemptyStrings"},
          "steps": {"$ref": "#/$defs/nonemptyStrings"},
          "expectations": {"$ref": "#/$defs/nonemptyStrings"},
          "observed_fields": {"$ref": "#/$defs/nonemptyStrings"}
        }
      }
    }
  },
  "$defs": {
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
