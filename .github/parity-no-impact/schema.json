{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pingcap/tiproxy/.github/parity-no-impact/schema-v1.json",
  "title": "TiProxy dataplane parity no-impact declaration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "reason", "owner", "review_url", "changes"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^NO-IMPACT-[A-Z0-9-]+$"},
    "reason": {"type": "string", "minLength": 40},
    "owner": {"type": "string", "pattern": "^@[A-Za-z0-9-]+$"},
    "review_url": {"type": "string", "pattern": "^https://github\\.com/.+/pull/[0-9]+#pullrequestreview-[0-9]+$"},
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "base_semantic_sha256", "head_semantic_sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "base_semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "head_semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
